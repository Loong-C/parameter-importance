{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage2-preregistration-amendment-v1.json",
  "title": "Append-only Stage 2.1 preregistration amendment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "amendment_id", "parent_preregistration_hash", "state",
    "created_before_confirmatory_draws", "reason", "changed_fields",
    "unchanged_fields", "non_posthoc_basis", "affected_gates", "append_only",
    "amendment_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage2-preregistration-amendment-v1"},
    "amendment_id": {"type": "string", "minLength": 1},
    "parent_preregistration_hash": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["DRAFT", "REVIEWED", "ACCEPTED", "REJECTED"]},
    "created_before_confirmatory_draws": {"const": true},
    "reason": {"type": "string", "minLength": 1},
    "changed_fields": {"type": "array"},
    "unchanged_fields": {"type": "array", "minItems": 1},
    "non_posthoc_basis": {"type": "string", "minLength": 1},
    "affected_gates": {"type": "array"},
    "append_only": {"const": true},
    "amendment_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

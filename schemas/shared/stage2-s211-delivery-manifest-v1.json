{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage2-s211-delivery-manifest-v1.json",
  "title": "Stage 2.11 append-only delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "gate_id", "run_id", "checked_at", "status", "formal_eligible", "append_only", "producer_commit", "consumer_commit", "g27b_gate_hash", "upstream_gate_hashes", "g27b_decision_hash", "stage2_lineage_hash", "boundary_hashes", "boundary_records", "replay_audit_31m_hash", "replay_instructions_hash", "replay_validator_hash", "delivery_role_hashes", "delivery_role_records", "estimator_decision", "replay_report", "gate_summary", "sync_report", "large_artifact_index", "worklog", "dirty_head_evidence", "failure_retry_amendment_history", "append_only_history_retained", "reasons", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage2-s211-delivery-manifest-v1"},
    "task_id": {"const": "stage2.11_delivery_and_exit_gate"},
    "gate_id": {"const": "stage2.G2.8"},
    "run_id": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "formal_eligible": {"type": "boolean"},
    "append_only": {"const": true},
    "producer_commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]},
    "consumer_commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]},
    "g27b_gate_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "upstream_gate_hashes": {"type": "object", "required": ["stage2.G2.0", "stage2.G2.1", "stage2.G2.2", "stage2.G2.3", "stage2.G2.4a", "stage2.G2.4b", "stage2.G2.5", "stage2.G2.6", "stage2.G2.7a", "stage2.G2.7b"], "additionalProperties": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}},
    "g27b_decision_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "stage2_lineage_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "boundary_hashes": {"type": "object", "additionalProperties": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}},
    "boundary_records": {"type": "object"},
    "replay_audit_31m_hash": {"$ref": "#/$defs/hash"},
    "replay_instructions_hash": {"$ref": "#/$defs/hash"},
    "replay_validator_hash": {"$ref": "#/$defs/hash"},
    "delivery_role_hashes": {"type": "object", "additionalProperties": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}},
    "delivery_role_records": {"type": "object"},
    "estimator_decision": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "replay_report": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "gate_summary": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "sync_report": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "large_artifact_index": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "worklog": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "dirty_head_evidence": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "failure_retry_amendment_history": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "append_only_history_retained": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}

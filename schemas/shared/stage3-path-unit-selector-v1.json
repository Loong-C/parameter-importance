{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-path-unit-selector-v1.json",
  "title": "Stage 3 path unit selector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "unit_index_hash",
    "active_unit_id",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage3-path-unit-selector-v1"},
    "scope": {"enum": ["pilot", "formal"]},
    "unit_index_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "active_unit_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

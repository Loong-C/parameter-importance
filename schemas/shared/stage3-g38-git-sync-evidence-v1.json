{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-g38-git-sync-evidence-v1.json",
  "title": "Stage 3 Git and multi-end synchronization evidence consumed by G3-8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "role", "scope", "status", "formal_eligible",
    "checked_at", "branch", "local_commit", "remote_commit", "server_commit",
    "remote_name", "local_delivery_worktree_clean", "server_worktree_clean",
    "agent_document_hashes", "command", "returncode", "stdout_log", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage3-g38-git-sync-evidence-v1"},
    "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "role": {
      "enum": ["branch", "commit", "push", "remote", "server_clean_head", "sync"]
    },
    "scope": {"const": "formal"},
    "status": {"const": "PASS"},
    "formal_eligible": {"const": true},
    "checked_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
    },
    "local_commit": {"$ref": "#/$defs/commit"},
    "remote_commit": {"$ref": "#/$defs/commit"},
    "server_commit": {"$ref": "#/$defs/commit"},
    "remote_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "local_delivery_worktree_clean": {"const": true},
    "server_worktree_clean": {"const": true},
    "agent_document_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Agent/git.md", "Agent/local.md", "Agent/remote_access.md",
        "Agent/server.md", "Agent/sync.md", "Agent/worklogs.md"
      ],
      "properties": {
        "Agent/git.md": {"$ref": "#/$defs/hash"},
        "Agent/local.md": {"$ref": "#/$defs/hash"},
        "Agent/remote_access.md": {"$ref": "#/$defs/hash"},
        "Agent/server.md": {"$ref": "#/$defs/hash"},
        "Agent/sync.md": {"$ref": "#/$defs/hash"},
        "Agent/worklogs.md": {"$ref": "#/$defs/hash"}
      }
    },
    "command": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "returncode": {"const": 0},
    "stdout_log": {"$ref": "#/$defs/file"},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!.*[?])(?!.*://)(?!.*\\\\)(?!.*fixture)(?!.*synthetic).+$"
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/ref"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0},
        "role": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
      }
    }
  }
}

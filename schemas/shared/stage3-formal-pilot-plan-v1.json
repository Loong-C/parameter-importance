{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-formal-pilot-plan-v1.json",
  "title": "Stage 3 preregistered formal quadrature pilot plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "scope", "candidate_rules", "required_unit_ids", "unit_strata", "thresholds", "execution_evidence_hash", "formal_eligible", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage3-formal-pilot-plan-v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "scope": {"const": "formal"},
    "candidate_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "required_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "plan_kind": {"enum": ["pilot", "matrix"]},
    "production_unit_index_scope": {"enum": ["pilot", "formal"]},
    "production_unit_index_ref": {"type": "string", "minLength": 1},
    "production_unit_index_hash": {"$ref": "#/$defs/hash"},
    "unit_strata": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/unitStratum"}
    },
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "execution_evidence_hash": {"$ref": "#/$defs/hash"},
    "formal_eligible": {"const": true},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "oneOf": [
    {"required": ["plan_kind", "production_unit_index_scope", "production_unit_index_ref", "production_unit_index_hash"]},
    {"not": {"anyOf": [
      {"required": ["plan_kind"]},
      {"required": ["production_unit_index_scope"]},
      {"required": ["production_unit_index_ref"]},
      {"required": ["production_unit_index_hash"]}
    ]}}
  ],
  "allOf": [
    {
      "if": {"properties": {"plan_kind": {"const": "pilot"}}, "required": ["plan_kind"]},
      "then": {"properties": {"production_unit_index_scope": {"const": "pilot"}}}
    },
    {
      "if": {"properties": {"plan_kind": {"const": "matrix"}}, "required": ["plan_kind"]},
      "then": {"properties": {"production_unit_index_scope": {"const": "formal"}}}
    },
    {
      "if": {"properties": {"plan_kind": {"const": "pilot"}}, "required": ["plan_kind"]},
      "then": {"properties": {"required_unit_ids": {"minItems": 12, "maxItems": 12}}}
    },
    {
      "if": {"properties": {"plan_kind": {"const": "matrix"}}, "required": ["plan_kind"]},
      "then": {"properties": {"required_unit_ids": {"minItems": 99, "maxItems": 99}}}
    },
    {
      "if": {"properties": {"required_unit_ids": {"minItems": 12}}},
      "then": {"required": ["plan_kind", "production_unit_index_scope", "production_unit_index_ref", "production_unit_index_hash"]}
    },
    {
      "if": {"properties": {"required_unit_ids": {"minItems": 99}}},
      "then": {"required": ["production_unit_index_ref", "production_unit_index_hash"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unitStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "stage", "update", "probe"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "stage": {"enum": ["early", "middle", "late"]},
        "update": {"type": "string", "minLength": 1},
        "probe": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_normalized_l1_error",
        "max_completeness_absolute_residual",
        "min_spearman",
        "min_topk_overlap",
        "max_unique_nodes",
        "max_normalized_l2_error",
        "max_normalized_linf_error",
        "max_completeness_relative_residual",
        "max_completeness_l1_scaled_residual",
        "min_active_spearman",
        "min_cosine_similarity",
        "min_sign_consistency",
        "min_topq_overlap",
        "min_topq_jaccard",
        "max_layer_quality_tv",
        "max_module_quality_tv",
        "max_reference_normalized_l1_error",
        "completeness_stability_epsilon",
        "active_set_threshold",
        "top_q_values",
        "required_strata",
        "require_worst_case"
      ],
      "properties": {
        "max_normalized_l1_error": {"type": "number", "minimum": 0},
        "max_completeness_absolute_residual": {"type": "number", "minimum": 0},
        "min_spearman": {"type": "number", "minimum": -1, "maximum": 1},
        "min_topk_overlap": {"type": "number", "minimum": 0, "maximum": 1},
        "max_unique_nodes": {"type": "integer", "minimum": 1},
        "max_normalized_l2_error": {"type": "number", "minimum": 0},
        "max_normalized_linf_error": {"type": "number", "minimum": 0},
        "max_completeness_relative_residual": {"type": "number", "minimum": 0},
        "max_completeness_l1_scaled_residual": {"type": "number", "minimum": 0},
        "min_active_spearman": {"type": "number", "minimum": -1, "maximum": 1},
        "min_cosine_similarity": {"type": "number", "minimum": -1, "maximum": 1},
        "min_sign_consistency": {"type": "number", "minimum": 0, "maximum": 1},
        "min_topq_overlap": {"type": "number", "minimum": 0, "maximum": 1},
        "min_topq_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
        "max_layer_quality_tv": {"type": "number", "minimum": 0},
        "max_module_quality_tv": {"type": "number", "minimum": 0},
        "max_reference_normalized_l1_error": {"type": "number", "minimum": 0},
        "completeness_stability_epsilon": {"type": "number", "exclusiveMinimum": 0},
        "active_set_threshold": {"type": "number", "minimum": 0},
        "top_q_values": {"const": [0.001, 0.01, 0.05]},
        "required_strata": {"const": ["model", "stage", "update", "probe"]},
        "require_worst_case": {"const": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-gate-evaluation-v1.json",
  "title": "Independent Stage 3 G3-0..G3-5 gate evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "status", "scope", "formal_eligible",
    "execution_evidence_hash", "formal_plan_hash", "formal_plan_ref", "thresholds_hash", "required_gate_ids", "gate_hashes",
    "required_rule_names", "required_unit_ids", "required_strata", "required_top_q", "rule_evaluations",
    "provenance_hash", "source_artifact_refs", "reasons",
    "stage3_scope_decision_ref", "stage3_scope_decision_hash",
    "stage3_scope_gate_ref", "stage3_scope_gate_hash", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage3-gate-evaluation-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "scope": {"enum": ["formal", "local_fixture"]},
    "formal_eligible": {"type": "boolean"},
    "execution_evidence_hash": {"$ref": "#/$defs/hash"},
    "formal_plan_hash": {"$ref": "#/$defs/hash"},
    "formal_plan_ref": {"type": "string", "minLength": 1},
    "thresholds_hash": {"$ref": "#/$defs/hash"},
    "required_gate_ids": {
      "const": ["stage3.G3-0", "stage3.G3-1", "stage3.G3-2", "stage3.G3-3", "stage3.G3-4", "stage3.G3-5"]
    },
    "gate_hashes": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/hash"}},
    "required_rule_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_strata": {"const": ["model", "stage", "update", "probe"]},
    "required_top_q": {"const": [0.001, 0.01, 0.05]},
    "rule_evaluations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/ruleEvaluation"}
    },
    "provenance_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "source_artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stage3_scope_decision_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "stage3_scope_decision_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "stage3_scope_gate_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "stage3_scope_gate_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"formal_eligible": {"const": true}}, "required": ["formal_eligible"]},
      "then": {
        "required": ["provenance_hash"],
        "properties": {
          "status": {"const": "PASS"},
          "scope": {"const": "formal"},
          "provenance_hash": {"$ref": "#/$defs/hash"},
          "source_artifact_refs": {"minItems": 1},
          "reasons": {"maxItems": 0},
          "stage3_scope_decision_ref": {"type": "string", "minLength": 1},
          "stage3_scope_decision_hash": {"$ref": "#/$defs/hash"},
          "stage3_scope_gate_ref": {"type": "string", "minLength": 1},
          "stage3_scope_gate_hash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    {
      "if": {"properties": {"formal_eligible": {"const": false}}, "required": ["formal_eligible"]},
      "then": {"properties": {"provenance_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ruleEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passing", "unit_ids", "missing_unit_ids", "missing_metrics",
        "worst_case_unit_ids", "worst_case_source", "strata_count", "violations"
      ],
      "properties": {
        "passing": {"type": "boolean"},
        "unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "worst_case_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "worst_case_source": {"const": "derived_from_complete_frozen_table"},
        "strata_count": {"type": "integer", "minimum": 0},
        "violations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

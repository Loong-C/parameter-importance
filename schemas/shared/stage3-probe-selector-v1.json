{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-probe-selector-v1.json",
  "title": "Stage 3 probe selector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "endpoint_digest",
    "probe_plan_hash",
    "active_probe_id",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage3-probe-selector-v1"},
    "scope": {"const": "formal"},
    "endpoint_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probe_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "active_probe_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage2-multi-round-execution-source-manifest-v1.json",
  "title": "S2.4 post-run queue-final source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "rounds", "no_pooling", "read_only", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage2-multi-round-execution-source-manifest-v1"},
    "study_id": {"const": "stage2-s204"},
    "no_pooling": {"const": true},
    "read_only": {"const": true},
    "rounds": {
      "type": "object", "additionalProperties": false,
      "required": ["r21", "r22"],
      "properties": {
        "r21": {"$ref": "#/$defs/r21"},
        "r22": {"$ref": "#/$defs/r22"}
      }
    },
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "queue_final", "evaluation"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "queue_final": {"$ref": "#/$defs/source"},
        "evaluation": {"type": ["null", "object"]}
      }
    },
    "r21": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts"],
      "properties": {"attempts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/attempt"}}}
    },
    "r22": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts"],
      "properties": {"attempts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}}}
    }
  }
}

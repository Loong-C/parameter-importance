{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-g38-replay-report-v1.json",
  "title": "Stage 3 three-layer replay evidence consumed by G3-8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "replay_id", "layer", "scope", "status", "formal_eligible",
    "implementation_commit", "environment_hash", "command", "returncode",
    "started_at", "completed_at", "cache_mode", "test_summary", "input_refs",
    "input_hashes", "evidence_files", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage3-g38-replay-report-v1"},
    "replay_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "layer": {"enum": ["local_cpu", "server_locked", "frozen_endpoint_uncached"]},
    "scope": {"const": "formal"},
    "status": {"const": "PASS"},
    "formal_eligible": {"const": true},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_hash": {"$ref": "#/$defs/hash"},
    "command": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "returncode": {"const": 0},
    "started_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "completed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "cache_mode": {"enum": ["not_applicable", "locked_environment", "uncached"]},
    "test_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["collected", "passed", "failed", "errors", "skipped"],
      "properties": {
        "collected": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 1},
        "failed": {"const": 0},
        "errors": {"const": 0},
        "skipped": {"const": 0}
      }
    },
    "input_refs": {"$ref": "#/$defs/refs"},
    "input_hashes": {"$ref": "#/$defs/hashes"},
    "evidence_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!.*[?])(?!.*://)(?!.*\\\\)(?!.*fixture)(?!.*synthetic).+$"
    },
    "refs": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/ref"}
    },
    "hashes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/ref"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0},
        "role": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
      }
    }
  }
}

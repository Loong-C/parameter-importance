{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage2-s211-output-inventory-v1.json",
  "title": "Stage 2.11 published output inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "formal_eligible", "append_only", "files", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage2-s211-output-inventory-v1"},
    "status": {"const": "PASS"},
    "formal_eligible": {"type": "boolean"},
    "append_only": {"const": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "bytes", "file_sha256", "artifact_hash"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "file_sha256": {"$ref": "#/$defs/hash"},
          "artifact_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
        }
      }
    },
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

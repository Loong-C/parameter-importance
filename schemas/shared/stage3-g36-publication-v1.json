{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/shared/stage3-g36-publication-v1.json",
  "title": "Independent Stage 3 G3-6 publication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "publication_id", "task_id", "config_hash", "status", "scope", "formal_eligible",
    "frozen_source_table_ref", "frozen_source_table_hash", "formal_plan_ref", "formal_plan_hash",
    "execution_evidence_ref", "execution_evidence_hash", "provenance_ref", "provenance_hash",
    "stage3_scope_decision_ref", "stage3_scope_decision_hash", "stage3_scope_gate_ref", "stage3_scope_gate_hash",
    "evaluation_ref", "evaluation_hash", "g3_6_ref", "g3_6_hash", "gate_evaluation", "g3_6_gate",
    "source_artifact_refs", "reasons", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage3-g36-publication-v1"},
    "publication_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "scope": {"const": "formal"},
    "formal_eligible": {"type": "boolean"},
    "frozen_source_table_ref": {"$ref": "#/$defs/ref"},
    "frozen_source_table_hash": {"$ref": "#/$defs/hash"},
    "formal_plan_ref": {"$ref": "#/$defs/ref"},
    "formal_plan_hash": {"$ref": "#/$defs/hash"},
    "execution_evidence_ref": {"$ref": "#/$defs/ref"},
    "execution_evidence_hash": {"$ref": "#/$defs/hash"},
    "provenance_ref": {"$ref": "#/$defs/ref"},
    "provenance_hash": {"$ref": "#/$defs/hash"},
    "stage3_scope_decision_ref": {"$ref": "#/$defs/ref"},
    "stage3_scope_decision_hash": {"$ref": "#/$defs/hash"},
    "stage3_scope_gate_ref": {"$ref": "#/$defs/ref"},
    "stage3_scope_gate_hash": {"$ref": "#/$defs/hash"},
    "evaluation_ref": {"$ref": "#/$defs/ref"},
    "evaluation_hash": {"$ref": "#/$defs/hash"},
    "g3_6_ref": {"$ref": "#/$defs/ref"},
    "g3_6_hash": {"$ref": "#/$defs/hash"},
    "gate_evaluation": {"$ref": "stage3-gate-evaluation-v1.json"},
    "g3_6_gate": {"$ref": "gate-record-v1.json"},
    "source_artifact_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "formal_eligible": {"const": true},
          "reasons": {"maxItems": 0},
          "gate_evaluation": {"properties": {"status": {"const": "PASS"}, "formal_eligible": {"const": true}}},
          "g3_6_gate": {"properties": {"gate_id": {"const": "stage3.G3-6"}, "status": {"const": "PASS"}}}
        }
      },
      "else": {
        "properties": {
          "formal_eligible": {"const": false},
          "reasons": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!.*[?])(?!.*://)(?!.*fixture)(?!.*synthetic).+$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g8-worker-plan-v1.json",
  "title": "Stage 0 G8 Capacity Worker Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile_id", "gate_id", "model_id", "mode", "precision_profile", "candidate_stage", "repeat_index", "world_size", "selected_gpu_uuids", "nccl_p2p_disable", "generator_git_commit", "config_ref", "config_sha256", "config_hash", "environment_ref", "environment_sha256", "environment_hash", "parameter_envelope_ref", "parameter_envelope_sha256", "parameter_envelope_hash", "work_envelope_ref", "work_envelope_sha256", "work_envelope_hash", "output_root_ref", "report_ref", "warmup_steps", "measured_steps", "memory_warmup_steps", "memory_measured_steps", "loader_worker_candidates", "run_loader_sweep", "checkpoint_steps", "collective_chunk_elements", "timeout_seconds", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage0-g8-worker-plan-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "profile_id": {"enum": ["g8-c-14m", "g8-s4-160m", "g8-s5-410m"]},
    "gate_id": {"enum": ["stage0.G8-C", "stage0.G8-S4", "stage0.G8-S5"]},
    "model_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["minimal", "formal"]},
    "precision_profile": {"enum": ["fp32", "bf16"]},
    "candidate_stage": {"enum": [0, 4, 5]},
    "repeat_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "world_size": {"enum": [1, 4]},
    "selected_gpu_uuids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^GPU-"}},
    "nccl_p2p_disable": {"const": 1},
    "generator_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_ref": {"$ref": "#/$defs/ref"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "environment_ref": {"$ref": "#/$defs/ref"},
    "environment_sha256": {"$ref": "#/$defs/hash"},
    "environment_hash": {"$ref": "#/$defs/hash"},
    "parameter_envelope_ref": {"$ref": "#/$defs/ref"},
    "parameter_envelope_sha256": {"$ref": "#/$defs/hash"},
    "parameter_envelope_hash": {"$ref": "#/$defs/hash"},
    "work_envelope_ref": {"$ref": "#/$defs/ref"},
    "work_envelope_sha256": {"$ref": "#/$defs/hash"},
    "work_envelope_hash": {"$ref": "#/$defs/hash"},
    "output_root_ref": {"$ref": "#/$defs/ref"},
    "report_ref": {"$ref": "#/$defs/ref"},
    "warmup_steps": {"const": 10},
    "measured_steps": {"const": 30},
    "memory_warmup_steps": {"const": 5},
    "memory_measured_steps": {"const": 20},
    "loader_worker_candidates": {"const": [0, 1, 2, 4]},
    "run_loader_sweep": {"type": "boolean"},
    "checkpoint_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 40}},
    "collective_chunk_elements": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}

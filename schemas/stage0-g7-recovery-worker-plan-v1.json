{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage0-g7-recovery-worker-plan-v1.json",
  "title": "Stage 0 G7 Recovery Worker Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "trajectory", "phase", "world_size", "selected_gpu_uuids", "generator_git_commit", "config_ref", "config_sha256", "config_hash", "environment_ref", "environment_sha256", "environment_hash", "execution_root_ref", "group_root_ref", "result_ref", "resume_group_checkpoint_id", "total_steps", "boundary_step", "timeout_seconds", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage0-g7-recovery-worker-plan-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "trajectory": {"enum": ["baseline", "recovery"]},
    "phase": {"enum": ["baseline", "interrupt", "resume"]},
    "world_size": {"enum": [1, 4]},
    "selected_gpu_uuids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^GPU-"}},
    "generator_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_ref": {"$ref": "#/$defs/ref"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "environment_ref": {"$ref": "#/$defs/ref"},
    "environment_sha256": {"$ref": "#/$defs/hash"},
    "environment_hash": {"$ref": "#/$defs/hash"},
    "execution_root_ref": {"$ref": "#/$defs/ref"},
    "group_root_ref": {"$ref": "#/$defs/ref"},
    "result_ref": {"$ref": "#/$defs/ref"},
    "resume_group_checkpoint_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "total_steps": {"const": 4},
    "boundary_step": {"const": 2},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}

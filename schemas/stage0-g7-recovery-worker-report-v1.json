{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g7-recovery-worker-report-v1.json",
  "title": "Stage 0 G7 Recovery Worker Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "trajectory", "phase", "status", "completed_at", "generator_git_commit", "plan_ref", "plan_sha256", "config_hash", "environment_hash", "world_size", "selected_gpu_uuids", "nccl_p2p_disable", "rank_identities", "total_steps", "boundary_step", "group_checkpoint_id", "group_root_ref", "rank_summaries", "group_save_seconds", "group_load_seconds", "peak_memory_bytes", "lineage_ref", "canonical_event_ref", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage0-g7-recovery-worker-report-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "trajectory": {"enum": ["baseline", "recovery"]},
    "phase": {"enum": ["baseline", "resume"]},
    "status": {"const": "PASS"},
    "completed_at": {"type": "string", "format": "date-time"},
    "generator_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_ref": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "environment_hash": {"$ref": "#/$defs/hash"},
    "world_size": {"enum": [1, 4]},
    "selected_gpu_uuids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^GPU-"}},
    "nccl_p2p_disable": {"const": 1},
    "rank_identities": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "total_steps": {"const": 4},
    "boundary_step": {"const": 2},
    "group_checkpoint_id": {"type": "string", "minLength": 1},
    "group_root_ref": {"type": "string", "minLength": 1},
    "rank_summaries": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "group_save_seconds": {"type": "number", "minimum": 0},
    "group_load_seconds": {"type": "number", "minimum": 0},
    "peak_memory_bytes": {"type": "integer", "minimum": 1},
    "lineage_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "canonical_event_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

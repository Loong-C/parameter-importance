{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g7-worker-report-v1.json",
  "title": "Stage 0 S0.8 paired overhead worker report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "mode", "repeat_index", "status", "completed_at",
    "generator_git_commit", "plan_ref", "plan_sha256", "config_hash",
    "environment_hash", "warmup_steps", "measured_steps", "matrix_size",
    "measured_wall_seconds", "steps_per_second", "step_median_seconds",
    "step_p95_seconds", "workload_checksum",
    "event_stream_ref", "event_stream_sha256", "event_count", "optimizer_steps",
    "event_append_median_seconds", "event_append_p95_seconds",
    "critical_flush_max_seconds", "derived_tracking_seconds",
    "tensorboard_scalar_count", "tensorboard_refs", "summary_ref", "status_ref",
    "resource_snapshots", "competition_free",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage0-g7-worker-report-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["minimal", "formal"]},
    "repeat_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "status": {"const": "PASS"},
    "completed_at": {"type": "string", "format": "date-time"},
    "generator_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_ref": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "warmup_steps": {"const": 10},
    "measured_steps": {"const": 30},
    "matrix_size": {"type": "integer", "minimum": 256},
    "measured_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "steps_per_second": {"type": "number", "exclusiveMinimum": 0},
    "step_median_seconds": {"type": "number", "exclusiveMinimum": 0},
    "step_p95_seconds": {"type": "number", "exclusiveMinimum": 0},
    "workload_checksum": {"type": "number"},
    "event_stream_ref": {"type": "string", "minLength": 1},
    "event_stream_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_count": {"const": 42},
    "optimizer_steps": {"type": "array", "minItems": 40, "maxItems": 40},
    "event_append_median_seconds": {"type": "number", "minimum": 0},
    "event_append_p95_seconds": {"type": "number", "minimum": 0},
    "critical_flush_max_seconds": {"type": "number", "minimum": 0},
    "derived_tracking_seconds": {"type": "number", "minimum": 0},
    "tensorboard_scalar_count": {"type": "integer", "minimum": 0},
    "tensorboard_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "summary_ref": {"type": ["string", "null"]},
    "status_ref": {"type": ["string", "null"]},
    "resource_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"type": "object"},
        "after": {"type": "object"}
      }
    },
    "competition_free": {"const": true},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

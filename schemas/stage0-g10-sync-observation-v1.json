{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g10-sync-observation-v1.json",
  "title": "Stage 0 G10 three-end synchronization observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collector_version", "observed_at", "authorization_ref",
    "branch", "expected_commit", "previous_github_head", "previous_server_head",
    "fast_forward_ancestry_verified", "force_push_used", "local", "github",
    "server", "agent_sync", "bundle_cleanup", "preserved_user_content",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage0-g10-sync-observation-v1"},
    "collector_version": {"const": "stage0-g10-sync-collector-v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "authorization_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "branch": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_commit": {"$ref": "#/$defs/commit"},
    "previous_github_head": {"$ref": "#/$defs/commit"},
    "previous_server_head": {"$ref": "#/$defs/commit"},
    "fast_forward_ancestry_verified": {"const": true},
    "force_push_used": {"const": false},
    "local": {"$ref": "#/$defs/local"},
    "github": {"$ref": "#/$defs/github"},
    "server": {"$ref": "#/$defs/server"},
    "agent_sync": {"$ref": "#/$defs/agentSync"},
    "bundle_cleanup": {"$ref": "#/$defs/bundleCleanup"},
    "preserved_user_content": {"$ref": "#/$defs/preservedContent"},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hashTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git.md", "remote_access.md", "server.md", "sync.md", "worklogs.md"],
      "properties": {
        "git.md": {"$ref": "#/$defs/hash"},
        "remote_access.md": {"$ref": "#/$defs/hash"},
        "server.md": {"$ref": "#/$defs/hash"},
        "sync.md": {"$ref": "#/$defs/hash"},
        "worklogs.md": {"$ref": "#/$defs/hash"}
      }
    },
    "local": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "head", "branch", "worktree_clean"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "minLength": 1},
        "worktree_clean": {"const": true}
      }
    },
    "github": {
      "type": "object", "additionalProperties": false,
      "required": ["remote", "remote_url", "branch_ref", "head", "push_verified"],
      "properties": {
        "remote": {"const": "origin"},
        "remote_url": {"const": "https://github.com/Loong-C/parameter-importance.git"},
        "branch_ref": {"type": "string", "pattern": "^refs/heads/"},
        "head": {"$ref": "#/$defs/commit"},
        "push_verified": {"const": true}
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["host_alias", "repository", "data_root", "head", "branch", "worktree_clean", "fast_forward_verified"],
      "properties": {
        "host_alias": {"const": "sophgo13-via-lab"},
        "repository": {"const": "/home/sophgo13/cjl/parameter-importance"},
        "data_root": {"const": "/home/sophgo13/cjl/storage/parameter-importance"},
        "head": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "minLength": 1},
        "worktree_clean": {"const": true},
        "fast_forward_verified": {"const": true}
      }
    },
    "agentSync": {
      "type": "object", "additionalProperties": false,
      "required": ["file_count_each_side", "files", "local_sha256", "server_sha256", "all_equal"],
      "properties": {
        "file_count_each_side": {"const": 5},
        "files": {"const": ["git.md", "remote_access.md", "server.md", "sync.md", "worklogs.md"]},
        "local_sha256": {"$ref": "#/$defs/hashTable"},
        "server_sha256": {"$ref": "#/$defs/hashTable"},
        "all_equal": {"const": true}
      }
    },
    "bundleCleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_name", "local_path", "server_path", "local_absent", "server_absent"],
      "properties": {
        "bundle_name": {"type": "string", "pattern": "^stage0-g10-sync-[0-9a-f]{12}\\.bundle$"},
        "local_path": {"type": "string", "minLength": 1},
        "server_path": {"type": "string", "pattern": "^/home/sophgo13/cjl/storage/parameter-importance/tmp/"},
        "local_absent": {"const": true},
        "server_absent": {"const": true}
      }
    },
    "preservedContent": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "tracked", "sha256"],
      "properties": {
        "path": {"const": "docs/mathematics.md"},
        "tracked": {"const": true},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g9-test-matrix-v1.json",
  "title": "Stage 0 G9 Required Test Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "skip_policy", "layers", "platform_exclusions", "regression_triggers", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage0-g9-test-matrix-v1"},
    "matrix_id": {"const": "stage0-g9-required-matrix-v1"},
    "skip_policy": {"const": "any_unapproved_skip_in_a_hard_layer_fails_g9"},
    "layers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "hard", "executor", "required_capabilities", "test_ids"],
        "properties": {
          "layer": {"enum": ["local_cpu", "server_cpu", "single_gpu", "four_gpu", "fault", "replay"]},
          "hard": {"const": true},
          "executor": {"type": "string", "minLength": 1},
          "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "platform_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "windows"],
      "properties": {
        "linux": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "windows": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "regression_triggers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changes", "rerun_layers"],
        "properties": {
          "changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "rerun_layers": {"type": "array", "uniqueItems": true, "items": {"enum": ["local_cpu", "server_cpu", "single_gpu", "four_gpu", "fault", "replay"]}}
        }
      }
    },
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/s1-6-training-fixture-v1.json",
  "title": "Stage 1 S1.6 frozen training fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "coordinate_order", "parameter_to_group", "sgd", "adamw_cases", "tiny_transformer", "scaler", "skip", "clip", "fixture_hash"],
  "properties": {
    "schema_version": {"const": "stage1-s1-6-training-fixture-v1"},
    "fixture_id": {"const": "stage1-s16-training-fixture-v1"},
    "coordinate_order": {"const": ["left", "right"]},
    "parameter_to_group": {"const": {"left": "group_0000", "right": "group_0001"}},
    "sgd": {"$ref": "#/$defs/sgd"},
    "adamw_cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/adamw"}, "allOf": [{"contains": {"type": "object", "properties": {"case_id": {"const": "zero_weight_decay"}}, "required": ["case_id"]}}, {"contains": {"type": "object", "properties": {"case_id": {"const": "decoupled_weight_decay"}}, "required": ["case_id"]}}]},
    "tiny_transformer": {"$ref": "#/$defs/tiny"},
    "scaler": {"$ref": "#/$defs/scaler"},
    "skip": {"$ref": "#/$defs/skip"},
    "clip": {"$ref": "#/$defs/clip"},
    "fixture_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vectorMap": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "number"}}, "right": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "number"}}}},
    "rates": {"type": "object", "additionalProperties": false, "required": ["group_0000", "group_0001"], "properties": {"group_0000": {"type": "number", "minimum": 0}, "group_0001": {"type": "number", "minimum": 0}}},
    "sgdStep": {"type": "object", "additionalProperties": false, "required": ["learning_rates", "microbatch_gradients"], "properties": {"learning_rates": {"$ref": "#/$defs/rates"}, "microbatch_gradients": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/vectorMap"}}}},
    "sgd": {"type": "object", "additionalProperties": false, "required": ["initial_parameters", "steps"], "properties": {"initial_parameters": {"$ref": "#/$defs/vectorMap"}, "steps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sgdStep"}}}},
    "adamw": {"type": "object", "additionalProperties": false, "required": ["case_id", "initial_parameter", "learning_rate", "weight_decay", "betas", "epsilon", "gradients"], "properties": {"case_id": {"enum": ["zero_weight_decay", "decoupled_weight_decay"]}, "initial_parameter": {"type": "number"}, "learning_rate": {"type": "number", "minimum": 0}, "weight_decay": {"type": "number", "minimum": 0}, "betas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}, "epsilon": {"type": "number", "exclusiveMinimum": 0}, "gradients": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}},
    "tinyMicro": {"type": "object", "additionalProperties": false, "required": ["batch_id", "input_ids", "labels", "sample_ids"], "properties": {"batch_id": {"type": "string", "pattern": "^s16-transformer-step-[01]-micro-[01]$"}, "input_ids": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "integer", "minimum": 0, "maximum": 16}}, "labels": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "integer", "minimum": 0, "maximum": 16}}, "sample_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "tiny": {"type": "object", "additionalProperties": false, "required": ["profile", "architecture", "initialization", "optimizer", "scheduler", "cursor_seed", "rng_seed", "microbatches"], "properties": {"profile": {"const": "T32_SINGLE"}, "architecture": {"type": "object", "additionalProperties": false, "required": ["vocab_size", "hidden_size", "num_heads", "max_length", "mlp_multiplier", "dropout"], "properties": {"vocab_size": {"const": 17}, "hidden_size": {"const": 8}, "num_heads": {"const": 2}, "max_length": {"const": 6}, "mlp_multiplier": {"const": 2}, "dropout": {"const": 0.0}}}, "initialization": {"type": "object", "additionalProperties": false, "required": ["rule", "scale", "offset_modulus", "bias"], "properties": {"rule": {"const": "arithmetic-v1"}, "scale": {"const": 0.0005}, "offset_modulus": {"const": 23}, "bias": {"const": -0.004}}}, "optimizer": {"type": "object", "additionalProperties": false, "required": ["name", "learning_rate", "weight_decay", "betas", "epsilon", "foreach"], "properties": {"name": {"const": "AdamW"}, "learning_rate": {"const": 0.05}, "weight_decay": {"const": 0.01}, "betas": {"const": [0.9, 0.999]}, "epsilon": {"const": 1e-8}, "foreach": {"const": false}}}, "scheduler": {"type": "object", "additionalProperties": false, "required": ["name", "step_size", "gamma"], "properties": {"name": {"const": "StepLR"}, "step_size": {"const": 1}, "gamma": {"const": 0.8}}}, "cursor_seed": {"const": 1}, "rng_seed": {"const": 6106}, "microbatches": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/tinyMicro"}}}}},
    "scaler": {"type": "object", "additionalProperties": false, "required": ["device", "enabled", "init_scale", "growth_factor", "backoff_factor", "growth_interval", "single_process_found_inf", "tiny_scale_before", "tiny_scale_after", "skip_scale_before", "skip_scale_after"], "properties": {"device": {"const": "cpu"}, "enabled": {"const": true}, "init_scale": {"const": 8.0}, "growth_factor": {"const": 2.0}, "backoff_factor": {"const": 0.5}, "growth_interval": {"const": 1}, "single_process_found_inf": {"const": "local_is_global"}, "tiny_scale_before": {"const": [8.0,16.0]}, "tiny_scale_after": {"const": [16.0,32.0]}, "skip_scale_before": {"const": [8.0,16.0,8.0]}, "skip_scale_after": {"const": [16.0,8.0,16.0]}}},
    "skip": {"type": "object", "additionalProperties": false, "required": ["nonfinite_step_index", "consumes_batch", "long_term_fields_unchanged"], "properties": {"nonfinite_step_index": {"const": 1}, "consumes_batch": {"const": true}, "long_term_fields_unchanged": {"const": ["signed", "positive", "negative_mass", "absolute", "raw", "raw_clipped", "data_movement", "net_data_movement", "total_movement", "total_endpoint_movement", "weight_decay_movement", "net_weight_decay_movement", "actual_update_raw_importance", "magnitude", "initial_parameters", "last_parameters"]}}},
    "clip": {"type":"object","additionalProperties":false,"required":["max_grad_norm","mean_gradient","global_norm","clip_epsilon","clip_factor"],"properties":{"max_grad_norm":{"const":0.5},"mean_gradient":{"const":{"left":[3.0],"right":[4.0]}},"global_norm":{"const":5.0},"clip_epsilon":{"const":1e-12},"clip_factor":{"const":0.09999999999998}}}
  }
}

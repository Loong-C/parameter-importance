{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/fixture-manifest-v1.json",
  "title": "Stage 1 S1.3 deterministic fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_set_id",
    "generator_version",
    "seed_plan",
    "gradient_matrix",
    "analytic",
    "tiny_transformer",
    "noise",
    "pythia_14m",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage1-fixture-manifest-v1"},
    "fixture_set_id": {"const": "stage1-s13-deterministic-v1"},
    "generator_version": {"type": "string", "minLength": 1},
    "seed_plan": {"type": "object"},
    "gradient_matrix": {"$ref": "#/$defs/object_section"},
    "analytic": {"$ref": "#/$defs/object_section"},
    "tiny_transformer": {"$ref": "#/$defs/object_section"},
    "noise": {"type": "array", "minItems": 1},
    "pythia_14m": {"$ref": "#/$defs/object_section"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "object_section": {
      "type": "object",
      "minProperties": 1
    }
  }
}

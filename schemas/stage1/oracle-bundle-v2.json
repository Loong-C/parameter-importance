{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/oracle-bundle-v2.json",
  "title": "Stage 1 S1.3 independent oracle bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_set_id", "producer_commit", "scope", "fixture_manifest_hash", "frozen_gradient_input_hash", "gradient_matrix", "analytic", "tiny_transformer", "zero_mean_noise", "offline_recompute", "bundle_hash"],
  "properties": {
    "schema_version": {"const": "stage1-oracle-bundle-v2"},
    "fixture_set_id": {"const": "stage1-s13-deterministic-v2"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {"enum": ["local_fixture", "formal"]},
    "fixture_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_gradient_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gradient_matrix": {"$ref": "#/$defs/gradient_matrix"},
    "analytic": {"type": "object", "minProperties": 1},
    "tiny_transformer": {"type": "object", "minProperties": 1},
    "zero_mean_noise": {"type": "object", "minProperties": 1},
    "offline_recompute": {"$ref": "#/$defs/offline_recompute"},
    "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "tensor_wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values"],
      "properties": {
        "dtype": {"const": "torch.float64"},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "values": {"type": "array", "items": {"type": "number"}}
      }
    },
    "tensor_map": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/tensor_wire"}},
    "sample_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tensor_map"}},
    "t64_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_profile", "absolute_threshold", "atol", "branch", "comparison_dtype", "max_absolute_error", "natural_scale", "near_zero_threshold", "nonfinite_count", "normalized_l2_error", "normalized_l2_limit", "passed", "rtol", "scaled_max_error", "worst_parameter"],
      "properties": {
        "comparison_profile": {"const": "T64_ORACLE"},
        "absolute_threshold": {"type": "number"},
        "atol": {"const": 1e-12},
        "branch": {"enum": ["near_zero_absolute", "scaled_nonzero"]},
        "comparison_dtype": {"const": "torch.float64_cpu"},
        "max_absolute_error": {"type": "number"},
        "natural_scale": {"type": "number", "exclusiveMinimum": 0},
        "near_zero_threshold": {"type": "number", "exclusiveMinimum": 0},
        "nonfinite_count": {"const": 0},
        "normalized_l2_error": {"type": ["number", "null"]},
        "normalized_l2_limit": {"const": 1e-10},
        "passed": {"const": true},
        "rtol": {"const": 1e-10},
        "scaled_max_error": {"type": ["number", "null"]},
        "worst_parameter": {"type": "string", "minLength": 1}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "seed"],
      "properties": {"stream_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer"}}
    },
    "permutation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "comparison"],
      "properties": {
        "order": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "comparison": {"$ref": "#/$defs/t64_comparison"}
      }
    },
    "case_common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "sample_count", "purpose", "natural_gradient_scale", "mean_gradient", "samples"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "purpose": {"type": "string", "minLength": 1},
        "natural_gradient_scale": {"type": "number", "exclusiveMinimum": 0},
        "mean_gradient": {"$ref": "#/$defs/tensor_map"},
        "samples": {"$ref": "#/$defs/sample_list"},
        "raw_oracle": {"$ref": "#/$defs/tensor_map"},
        "equal_u_oracle": {"$ref": "#/$defs/tensor_map"},
        "weighted_u_oracle": {"$ref": "#/$defs/tensor_map"},
        "weights": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "raw_identity_comparison": {"$ref": "#/$defs/t64_comparison"},
        "equal_u_identity_comparison": {"$ref": "#/$defs/t64_comparison"},
        "weighted_u_identity_comparison": {"$ref": "#/$defs/t64_comparison"},
        "m1_rejection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_type", "message"],
          "properties": {"status": {"const": "PASS"}, "error_type": {"const": "Stage1FixtureError"}, "message": {"type": "string", "minLength": 1}}
        }
      }
    },
    "raw_equal_case": {"allOf": [{"$ref": "#/$defs/case_common"}, {"required": ["raw_oracle", "equal_u_oracle", "raw_identity_comparison", "equal_u_identity_comparison"]}]},
    "weighted_case": {"allOf": [{"$ref": "#/$defs/case_common"}, {"required": ["raw_oracle", "equal_u_oracle", "raw_identity_comparison", "equal_u_identity_comparison", "weights", "weighted_u_oracle", "weighted_u_identity_comparison"]}]},
    "m1_case": {"allOf": [{"$ref": "#/$defs/case_common"}, {"required": ["m1_rejection"]}]},
    "gradient_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "coordinate_shapes", "cases", "independent_double_sample"],
      "properties": {
        "schema_version": {"const": "stage1-gradient-matrix-fixture-v2"},
        "coordinate_shapes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attention.bias", "embedding.weight", "head.weight"],
          "properties": {
            "attention.bias": {"const": [2]},
            "embedding.weight": {"const": [2, 2]},
            "head.weight": {"const": [1, 3]}
          }
        },
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zero-m2", "equal-m3", "negative-u-m2", "varied-m4", "m1-boundary", "permutations"],
          "properties": {
            "zero-m2": {"allOf": [{"$ref": "#/$defs/raw_equal_case"}, {"properties": {"case_id": {"const": "zero-m2"}}}]},
            "equal-m3": {"allOf": [{"$ref": "#/$defs/raw_equal_case"}, {"properties": {"case_id": {"const": "equal-m3"}}}]},
            "negative-u-m2": {"allOf": [{"$ref": "#/$defs/raw_equal_case"}, {"properties": {"case_id": {"const": "negative-u-m2"}}}]},
            "varied-m4": {"allOf": [{"$ref": "#/$defs/weighted_case"}, {"properties": {"case_id": {"const": "varied-m4"}}}]},
            "m1-boundary": {"allOf": [{"$ref": "#/$defs/m1_case"}, {"properties": {"case_id": {"const": "m1-boundary"}}}]},
            "permutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/permutation_record"}}
          }
        },
        "independent_double_sample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "purpose", "natural_gradient_scale", "samples_a", "samples_b", "source_a", "source_b", "mean_a", "mean_b", "double_sample_oracle", "double_sample_identity_comparison"],
          "properties": {
            "case_id": {"const": "independent-ab-v1"},
            "purpose": {"type": "string", "minLength": 1},
            "natural_gradient_scale": {"type": "number", "exclusiveMinimum": 0},
            "samples_a": {"$ref": "#/$defs/sample_list"},
            "samples_b": {"$ref": "#/$defs/sample_list"},
            "source_a": {"$ref": "#/$defs/source_identity"},
            "source_b": {"$ref": "#/$defs/source_identity"},
            "mean_a": {"$ref": "#/$defs/tensor_map"},
            "mean_b": {"$ref": "#/$defs/tensor_map"},
            "double_sample_oracle": {"$ref": "#/$defs/tensor_map"},
            "double_sample_identity_comparison": {"$ref": "#/$defs/t64_comparison"}
          }
        }
      }
    },
    "offline_recompute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "formal_estimator_imported", "recomputed_from_saved_values", "comparison_profile", "saved_oracles_compared", "objects"],
      "properties": {
        "algorithm": {"const": "explicit_fp64_loops_over_serialized_inputs"},
        "formal_estimator_imported": {"const": false},
        "recomputed_from_saved_values": {"const": true},
        "comparison_profile": {"const": "T64_ORACLE"},
        "saved_oracles_compared": {"const": true},
        "objects": {"const": ["raw_oracle", "double_sample_oracle", "equal_u_oracle", "weighted_u_oracle"]}
      }
    }
  }
}

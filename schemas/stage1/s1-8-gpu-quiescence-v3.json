{
  "$id": "stage1-s1-8-gpu-quiescence-v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "phase",
    "started_at",
    "timeout_seconds",
    "sample_interval_seconds",
    "required_consecutive_exact_idle_samples",
    "max_transient_samples",
    "transient_observation_count",
    "operational_timeout_basis",
    "samples",
    "final_gpu",
    "failure_reason",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "stage1-s1-8-gpu-quiescence-v3"
    },
    "status": {
      "enum": [
        "PASS",
        "FAILED"
      ]
    },
    "phase": {
      "enum": [
        "prelease",
        "post_worker",
        "post_release",
        "reacquire_preflight"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "timeout_seconds": {
      "const": 180.0
    },
    "sample_interval_seconds": {
      "const": 1.0
    },
    "required_consecutive_exact_idle_samples": {
      "const": 3
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "final_gpu": {
      "anyOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hash": {
      "$ref": "s1-8-formalization-index-v1.json#/$defs/hash"
    },
    "operational_timeout_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_method",
        "combined_inventory_recovery_seconds",
        "compute_apps_seconds",
        "two_query_sample_seconds",
        "maximum_transient_samples",
        "per_sample_management_budget_seconds",
        "maximum_sample_count",
        "maximum_cadence_count",
        "nine_samples_plus_eight_cadences_seconds",
        "fixed_timeout_seconds",
        "fixed_margin_seconds",
        "dynamic_fitting"
      ],
      "properties": {
        "measurement_method": {
          "const": "frozen_linux_cpu_only_nvidia_smi_management_queries"
        },
        "combined_inventory_recovery_seconds": {
          "const": 6.166325362000862
        },
        "compute_apps_seconds": {
          "const": 6.113894288000665
        },
        "two_query_sample_seconds": {
          "const": 12.280219650001527
        },
        "maximum_transient_samples": {
          "const": 2
        },
        "per_sample_management_budget_seconds": {
          "const": 15.0
        },
        "maximum_sample_count": {
          "const": 9
        },
        "maximum_cadence_count": {
          "const": 8
        },
        "nine_samples_plus_eight_cadences_seconds": {
          "const": 143.0
        },
        "fixed_timeout_seconds": {
          "const": 180.0
        },
        "fixed_margin_seconds": {
          "const": 37.0
        },
        "dynamic_fitting": {
          "const": false
        }
      }
    },
    "max_transient_samples": {
      "const": 2
    },
    "transient_observation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  },
  "$defs": {
    "gpu_uuid": {
      "$ref": "s1-8-formalization-index-v1.json#/$defs/gpu_uuid"
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_index",
        "uuid",
        "name",
        "memory_total_mib",
        "memory_used_mib",
        "utilization_percent",
        "temperature_c",
        "compute_capability",
        "recovery_action"
      ],
      "properties": {
        "physical_index": {
          "type": "integer",
          "minimum": 0
        },
        "uuid": {
          "$ref": "#/$defs/gpu_uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "memory_total_mib": {
          "type": "integer",
          "minimum": 0
        },
        "memory_used_mib": {
          "type": "integer",
          "minimum": 0
        },
        "utilization_percent": {
          "type": "integer",
          "minimum": 0
        },
        "temperature_c": {
          "type": "integer",
          "minimum": 0
        },
        "compute_capability": {
          "type": "string",
          "minLength": 1
        },
        "recovery_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compute_app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_uuid",
        "pid",
        "process_name"
      ],
      "properties": {
        "gpu_uuid": {
          "$ref": "#/$defs/gpu_uuid"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "process_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "requested_uuid_order",
        "compute_apps"
      ],
      "properties": {
        "selected": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/gpu"
          }
        },
        "requested_uuid_order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gpu_uuid"
          }
        },
        "compute_apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compute_app"
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_index",
        "observed_at",
        "monotonic_elapsed_seconds",
        "requested_uuid_order",
        "selected",
        "compute_apps",
        "violations",
        "exact_selected_idle",
        "consecutive_exact_idle_samples",
        "transient_observation_count"
      ],
      "properties": {
        "sample_index": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "monotonic_elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "requested_uuid_order": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gpu_uuid"
          }
        },
        "selected": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/gpu"
          }
        },
        "compute_apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compute_app"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exact_selected_idle": {
          "type": "boolean"
        },
        "consecutive_exact_idle_samples": {
          "type": "integer",
          "minimum": 0
        },
        "transient_observation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}

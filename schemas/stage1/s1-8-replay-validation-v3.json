{
  "$id": "stage1-s1-8-replay-validation-v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "fixture_schema_version",
    "fixture_id",
    "oracle_import_isolated",
    "oracle_reference_dtype",
    "production_candidate_dtype",
    "checks",
    "scalar_checks",
    "comparison_rows",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "stage1-s1-8-replay-validation-v3"
    },
    "status": {
      "const": "PASS"
    },
    "fixture_schema_version": {
      "const": "stage1-s1-8-fixture-manifest-v3"
    },
    "fixture_id": {
      "const": "stage1-s1-8-pythia14m-ddp-conditioned-v3"
    },
    "oracle_import_isolated": {
      "const": true
    },
    "oracle_reference_dtype": {
      "const": "torch.float64"
    },
    "production_candidate_dtype": {
      "const": "torch.float32"
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/map_check"
      }
    },
    "scalar_checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/scalar_float"
          },
          {
            "$ref": "#/$defs/scalar_exact"
          }
        ]
      }
    },
    "comparison_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/comparison_row"
          },
          {
            "$ref": "#/$defs/step_row"
          }
        ]
      }
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "map_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_abs_error",
        "worst_parameter",
        "worst_index",
        "normalized_l2_error",
        "near_zero_object_count",
        "violation_count",
        "within_t32_distributed",
        "per_tensor"
      ],
      "properties": {
        "max_abs_error": {
          "type": "number"
        },
        "worst_parameter": {
          "type": "string"
        },
        "worst_index": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "normalized_l2_error": {
          "type": [
            "number",
            "null"
          ]
        },
        "near_zero_object_count": {
          "type": "integer",
          "minimum": 0
        },
        "violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "within_t32_distributed": {
          "const": true
        },
        "reference_kind": {
          "enum": [
            "production_peer_fp32_promoted_to_fp64_for_metric_only",
            "fp32_execution_order_emulator_using_A_full_batch_production_mean_after_independent_check",
            "fp32_execution_order_emulator_using_route_fp32_sufficient_statistic_mean_after_independent_check"
          ]
        },
        "per_tensor": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/tensor_comparison"
              },
              {
                "$ref": "#/$defs/step_detail"
              }
            ]
          }
        }
      }
    },
    "tensor_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "near_zero_branch",
        "natural_scale",
        "near_zero_threshold",
        "absolute_threshold",
        "max_abs_error",
        "max_scaled_error",
        "normalized_l2_error",
        "candidate_dtype",
        "reference_dtype",
        "within_t32_distributed"
      ],
      "properties": {
        "near_zero_branch": {
          "type": "boolean"
        },
        "natural_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "near_zero_threshold": {
          "type": "number",
          "minimum": 0
        },
        "absolute_threshold": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_error": {
          "type": "number",
          "minimum": 0
        },
        "max_scaled_error": {
          "type": "number",
          "minimum": 0
        },
        "normalized_l2_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "candidate_dtype": {
          "const": "torch.float32"
        },
        "reference_dtype": {
          "const": "torch.float64"
        },
        "within_t32_distributed": {
          "const": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "near_zero_branch": {
              "const": true
            },
            "normalized_l2_error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "near_zero_branch": {
              "const": false
            },
            "normalized_l2_error": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "step_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_step",
        "observed",
        "exact_equality",
        "within_t32_distributed"
      ],
      "properties": {
        "expected_step": {
          "type": "integer",
          "minimum": 1
        },
        "observed": {
          "type": "number"
        },
        "exact_equality": {
          "const": true
        },
        "within_t32_distributed": {
          "const": true
        }
      }
    },
    "scalar_float": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_fp64",
        "observed",
        "absolute_error",
        "within_t32_distributed"
      ],
      "properties": {
        "expected_fp64": {
          "type": "number"
        },
        "observed": {
          "type": "number"
        },
        "absolute_error": {
          "type": "number",
          "minimum": 0
        },
        "within_t32_distributed": {
          "const": true
        }
      }
    },
    "scalar_exact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "observed",
        "exact_equality",
        "within_t32_distributed"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "exact_equality": {
          "const": true
        },
        "within_t32_distributed": {
          "const": true
        }
      }
    },
    "comparison_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "parameter",
        "near_zero_branch",
        "natural_scale",
        "near_zero_threshold",
        "absolute_threshold",
        "max_abs_error",
        "max_scaled_error",
        "normalized_l2_error",
        "candidate_dtype",
        "reference_dtype",
        "within_t32_distributed"
      ],
      "properties": {
        "comparison": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "near_zero_branch": {
          "type": "boolean"
        },
        "natural_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "near_zero_threshold": {
          "type": "number",
          "minimum": 0
        },
        "absolute_threshold": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_error": {
          "type": "number",
          "minimum": 0
        },
        "max_scaled_error": {
          "type": "number",
          "minimum": 0
        },
        "normalized_l2_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "candidate_dtype": {
          "const": "torch.float32"
        },
        "reference_dtype": {
          "const": "torch.float64"
        },
        "within_t32_distributed": {
          "const": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "near_zero_branch": {
              "const": true
            },
            "normalized_l2_error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "near_zero_branch": {
              "const": false
            },
            "normalized_l2_error": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "step_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "parameter",
        "expected_step",
        "observed",
        "exact_equality",
        "within_t32_distributed"
      ],
      "properties": {
        "comparison": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "expected_step": {
          "type": "integer",
          "minimum": 1
        },
        "observed": {
          "type": "number"
        },
        "exact_equality": {
          "const": true
        },
        "within_t32_distributed": {
          "const": true
        }
      }
    }
  }
}

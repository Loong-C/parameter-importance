{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/g1-est-oracle-report-v1.json",
  "title": "Stage 1 G1-EST independent FP64 oracle",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "producer_commit", "scope", "oracle_algorithm", "bundle_hash", "profiles", "oracle_hash"],
  "properties": {"schema_version": {"const": "stage1-g1-est-oracle-report-v1"}, "fixture_id": {"const": "stage1-s15-estimator-fixture-v1"}, "producer_commit": {"$ref": "#/$defs/commit"}, "scope": {"enum": ["local_fixture", "formal"]}, "oracle_algorithm": {"const": "explicit_fp64_python_pair_loops_without_production_estimators"}, "bundle_hash": {"$ref": "#/$defs/digest"}, "profiles": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/profile"}}, "oracle_hash": {"$ref": "#/$defs/digest"}},
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "wireCoordinate": {"type": "object", "additionalProperties": false, "required": ["dtype", "shape", "values"], "properties": {"dtype": {"const": "torch.float64"}, "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}}},
    "wireMap": {"type": "object", "additionalProperties": false, "required": ["bias", "head", "weight"], "properties": {"bias": {"allOf": [{"$ref": "#/$defs/wireCoordinate"}, {"type": "object", "properties": {"shape": {"const": [2]}}}]}, "head": {"allOf": [{"$ref": "#/$defs/wireCoordinate"}, {"type": "object", "properties": {"shape": {"const": [1]}}}]}, "weight": {"allOf": [{"$ref": "#/$defs/wireCoordinate"}, {"type": "object", "properties": {"shape": {"const": [3]}}}]}}},
    "statistics": {"type": "object", "additionalProperties": false, "required": ["S1", "S2", "G1", "G2", "N1", "N2"], "properties": {"S1": {"$ref": "#/$defs/wireMap"}, "S2": {"$ref": "#/$defs/wireMap"}, "G1": {"$ref": "#/$defs/wireMap"}, "G2": {"$ref": "#/$defs/wireMap"}, "N1": {"const": 10.0}, "N2": {"const": 30.0}}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["raw_core", "raw_score", "raw_clipped_score", "double_core", "double_score", "equal_u_ordered_core", "equal_u_unordered_core", "equal_u_streaming_core", "equal_u_score", "weighted_u_core", "weighted_u_score", "weighted_equal_count_degenerate_core", "m2_u_equals_double_core", "double_exchange_core", "identical_gradient_u_core", "identical_gradient_u_score", "equal_u_reverse_permutation_core", "equal_u_rotate_permutation_core", "weighted_u_reverse_paired_permutation_core", "weighted_u_rotate_paired_permutation_core"], "patternProperties": {"^(raw_core|raw_score|raw_clipped_score|double_core|double_score|equal_u_ordered_core|equal_u_unordered_core|equal_u_streaming_core|equal_u_score|weighted_u_core|weighted_u_score|weighted_equal_count_degenerate_core|m2_u_equals_double_core|double_exchange_core|identical_gradient_u_core|identical_gradient_u_score|equal_u_reverse_permutation_core|equal_u_rotate_permutation_core|weighted_u_reverse_paired_permutation_core|weighted_u_rotate_paired_permutation_core)$": {"$ref": "#/$defs/wireMap"}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["raw_unclipped_core", "raw_clipped_core", "negative_u", "zero_raw_core", "zero_u_core"], "properties": {"raw_unclipped_core": {"$ref": "#/$defs/wireMap"}, "raw_clipped_core": {"$ref": "#/$defs/wireMap"}, "negative_u": {"$ref": "#/$defs/wireMap"}, "zero_raw_core": {"$ref": "#/$defs/wireMap"}, "zero_u_core": {"$ref": "#/$defs/wireMap"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile", "natural_scales", "sufficient_statistics", "oracle_outputs", "boundary_outputs"], "properties": {"profile": {"enum": ["T64_ORACLE", "T32_SINGLE"]}, "natural_scales": {"type": "object", "additionalProperties": false, "required": ["core", "score"], "properties": {"core": {"const": 16.0}, "score": {"const": 4.0}}}, "sufficient_statistics": {"$ref": "#/$defs/statistics"}, "oracle_outputs": {"$ref": "#/$defs/outputs"}, "boundary_outputs": {"$ref": "#/$defs/boundaries"}}}
  }
}

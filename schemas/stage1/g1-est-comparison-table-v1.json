{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/g1-est-comparison-table-v1.json",
  "title": "Stage 1 G1-EST exact report projection",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "report_hash", "rows", "scatter_rows", "scaling_rows", "negative_u_rows", "projection_hash", "table_hash"],
  "properties": {"schema_version": {"const": "stage1-g1-est-comparison-table-v1"}, "fixture_id": {"const": "stage1-s15-estimator-fixture-v1"}, "report_hash": {"$ref": "#/$defs/digest"}, "rows": {"type": "array", "minItems": 120, "maxItems": 120, "items": {"$ref": "#/$defs/errorRow"}}, "scatter_rows": {"type": "array", "minItems": 36, "maxItems": 36, "items": {"$ref": "#/$defs/scatterRow"}}, "scaling_rows": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/scalingRow"}}, "negative_u_rows": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/negativeRow"}}, "projection_hash": {"$ref": "#/$defs/digest"}, "table_hash": {"$ref": "#/$defs/digest"}},
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "errorRow": {"type": "object", "additionalProperties": false, "required": ["profile", "comparison_id", "object_id", "parameter_name", "passed", "branch", "comparison_dtype", "natural_scale", "atol", "rtol", "normalized_l2_limit", "near_zero_threshold", "absolute_threshold", "max_absolute_error", "scaled_max_error", "normalized_l2_error", "nonfinite_count", "worst_parameter"], "properties": {"profile": {"enum": ["T64_ORACLE", "T32_SINGLE"]}, "comparison_id": {"enum": ["raw_core", "raw_score", "raw_clipped_score", "double_core", "double_score", "equal_u_ordered_core", "equal_u_unordered_core", "equal_u_streaming_core", "equal_u_score", "weighted_u_core", "weighted_u_score", "weighted_equal_count_degenerate_core", "m2_u_equals_double_core", "double_exchange_core", "identical_gradient_u_core", "identical_gradient_u_score", "equal_u_reverse_permutation_core", "equal_u_rotate_permutation_core", "weighted_u_reverse_paired_permutation_core", "weighted_u_rotate_paired_permutation_core"]}, "object_id": {"enum": ["estimator_core", "estimator_score"]}, "parameter_name": {"enum": ["bias", "head", "weight"]}, "passed": {"const": true}, "branch": {"enum": ["near_zero_absolute", "scaled_nonzero"]}, "comparison_dtype": {"const": "torch.float64_cpu"}, "natural_scale": {"type": "number", "exclusiveMinimum": 0}, "atol": {"type": "number", "minimum": 0}, "rtol": {"type": "number", "minimum": 0}, "normalized_l2_limit": {"type": "number", "minimum": 0}, "near_zero_threshold": {"type": "number", "minimum": 0}, "absolute_threshold": {"type": "number", "minimum": 0}, "max_absolute_error": {"type": ["number", "null"]}, "scaled_max_error": {"type": ["number", "null"]}, "normalized_l2_error": {"type": ["number", "null"]}, "nonfinite_count": {"const": 0}, "worst_parameter": {"type": ["string", "null"]}}},
    "scatterRow": {"type": "object", "additionalProperties": false, "required": ["profile", "route_id", "parameter_name", "coordinate", "candidate", "reference"], "properties": {"profile": {"enum": ["T64_ORACLE", "T32_SINGLE"]}, "route_id": {"enum": ["equal_u_ordered_vs_oracle", "equal_u_unordered_vs_oracle", "equal_u_streaming_vs_oracle"]}, "parameter_name": {"enum": ["bias", "head", "weight"]}, "coordinate": {"type": "integer", "minimum": 0}, "candidate": {"type": "number"}, "reference": {"type": "number"}}},
    "scalingRow": {"type": "object", "additionalProperties": false, "required": ["profile", "parameter_name", "parameter_group", "coordinate", "learning_rate", "clip_factor", "raw_core", "raw_score", "raw_clipped_score", "u_core", "u_score"], "properties": {"profile": {"enum": ["T64_ORACLE", "T32_SINGLE"]}, "parameter_name": {"enum": ["bias", "head", "weight"]}, "parameter_group": {"enum": ["group_0000", "group_0001"]}, "coordinate": {"type": "integer", "minimum": 0}, "learning_rate": {"type": "number", "exclusiveMinimum": 0}, "clip_factor": {"const": 0.4}, "raw_core": {"type": "number"}, "raw_score": {"type": "number"}, "raw_clipped_score": {"type": "number"}, "u_core": {"type": "number"}, "u_score": {"type": "number"}}},
    "negativeRow": {"type": "object", "additionalProperties": false, "required": ["profile", "parameter_name", "coordinate", "u_core"], "properties": {"profile": {"enum": ["T64_ORACLE", "T32_SINGLE"]}, "parameter_name": {"enum": ["bias", "head", "weight"]}, "coordinate": {"type": "integer", "minimum": 0}, "u_core": {"type": "number", "exclusiveMaximum": 0}}}
  }
}

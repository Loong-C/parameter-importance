{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/oracle-bundle-v1.json",
  "title": "Stage 1 S1.3 independent oracle bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_set_id",
    "producer_commit",
    "scope",
    "fixture_manifest_hash",
    "gradient_matrix",
    "analytic",
    "tiny_transformer",
    "zero_mean_noise",
    "offline_recompute",
    "bundle_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage1-oracle-bundle-v1"},
    "fixture_set_id": {"const": "stage1-s13-deterministic-v1"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {"enum": ["local_fixture", "formal"]},
    "fixture_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gradient_matrix": {"type": "object", "minProperties": 1},
    "analytic": {"type": "object", "minProperties": 1},
    "tiny_transformer": {"type": "object", "minProperties": 1},
    "zero_mean_noise": {"type": "object", "minProperties": 1},
    "offline_recompute": {"type": "object", "minProperties": 1},
    "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

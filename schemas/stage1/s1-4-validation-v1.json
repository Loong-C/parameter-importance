{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/s1-4-validation-v1.json",
  "title": "Stage 1 S1.4 formal validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "gate_id", "task_id", "execution_scope", "fixture_id", "producer_commit", "consumer_commit", "upstream", "regression", "direct_checks", "role_sha256", "csv_sha256", "svg_sha256", "replay_sha256", "replay_hash", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage1-s1-4-validation-v1"}, "status": {"const": "PASS"}, "gate_id": {"const": "G1-GRAD"}, "task_id": {"const": "stage1.04_loss_and_gradient_scale"}, "execution_scope": {"const": "formal_server_cpu"}, "fixture_id": {"const": "stage1-s14-loss-gradient-fixture-v1"}, "producer_commit": {"$ref": "#/$defs/commit"}, "consumer_commit": {"$ref": "#/$defs/commit"}, "upstream": {"$ref": "#/$defs/upstream"}, "regression": {"$ref": "#/$defs/regression"}, "direct_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/directCheck"}}, "role_sha256": {"$ref": "#/$defs/roleMap"}, "csv_sha256": {"$ref": "#/$defs/csvMap"}, "svg_sha256": {"$ref": "#/$defs/svgMap"}, "replay_sha256": {"$ref": "#/$defs/digest"}, "replay_hash": {"$ref": "#/$defs/digest"}, "artifact_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream": {"type": "object", "additionalProperties": false, "required": ["s1_3_index_ref", "s1_3_index_sha256", "s1_3_gate_artifact_hash", "s1_3_frozen_gradient_input_hash"], "properties": {"s1_3_index_ref": {"type": "string", "minLength": 1}, "s1_3_index_sha256": {"$ref": "#/$defs/digest"}, "s1_3_gate_artifact_hash": {"$ref": "#/$defs/digest"}, "s1_3_frozen_gradient_input_hash": {"$ref": "#/$defs/digest"}}},
    "regression": {"type": "object", "additionalProperties": false, "required": ["schema_version", "command", "returncode", "stdout_sha256", "stderr_sha256", "stdout_tail", "stderr_tail"], "properties": {"schema_version": {"const": "stage1-s1-4-regression-v1"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "returncode": {"const": 0}, "stdout_sha256": {"$ref": "#/$defs/digest"}, "stderr_sha256": {"$ref": "#/$defs/digest"}, "stdout_tail": {"type": "string"}, "stderr_tail": {"type": "string"}}},
    "directCheck": {"type": "object", "additionalProperties": false, "required": ["check_id", "status", "detail"], "properties": {"check_id": {"type": "string"}, "status": {"const": "PASS"}, "detail": {"type": "string"}}},
    "roleMap": {"type": "object", "additionalProperties": false, "required": ["gradient_scale_report", "comparison_table", "gate_record"], "properties": {"gradient_scale_report": {"$ref": "#/$defs/digest"}, "comparison_table": {"$ref": "#/$defs/digest"}, "gate_record": {"$ref": "#/$defs/digest"}}},
    "csvMap": {"type": "object", "additionalProperties": false, "required": ["tensor-errors.csv", "gradient-scatter.csv", "tensor-error-heatmap.csv", "accumulation-errors.csv"], "properties": {"tensor-errors.csv": {"$ref": "#/$defs/digest"}, "gradient-scatter.csv": {"$ref": "#/$defs/digest"}, "tensor-error-heatmap.csv": {"$ref": "#/$defs/digest"}, "accumulation-errors.csv": {"$ref": "#/$defs/digest"}}},
    "svgMap": {"type": "object", "additionalProperties": false, "required": ["gradient-scatter.svg", "route-errors.svg", "tensor-error-heatmap.svg", "accumulation-errors.svg"], "properties": {"gradient-scatter.svg": {"$ref": "#/$defs/digest"}, "route-errors.svg": {"$ref": "#/$defs/digest"}, "tensor-error-heatmap.svg": {"$ref": "#/$defs/digest"}, "accumulation-errors.svg": {"$ref": "#/$defs/digest"}}}
  }
}

  "properties": {"schema_version": {"const": "stage1-g1-est-tensor-bundle-v1"}, "fixture_id": {"const": "stage1-s15-estimator-fixture-v1"}, "producer_commit": {"$ref": "#/$defs/commit"}, "scope": {"enum": ["local_fixture", "formal"]}, "fixture_manifest_hash": {"$ref": "#/$defs/digest"}, "fixture_manifest_sha256": {"$ref": "#/$defs/digest"}, "coordinate_contract": {"$ref": "#/$defs/coordinateContract"}, "estimator_input_contract": {"$ref": "#/$defs/inputContract"}, "profiles": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/profile"}}, "bundle_hash": {"$ref": "#/$defs/digest"}},

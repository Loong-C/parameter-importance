{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage1/s1-3-formalization-index-v1.json",
  "title": "Stage 1 S1.3 formalization index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "gate_id",
    "task_id",
    "generator_git_commit",
    "consumer_git_commit",
    "git_branch",
    "checked_at",
    "s1_2_index_ref",
    "s1_2_index_sha256",
    "s1_2_gate_artifact_hash",
    "fixture_manifest_ref",
    "fixture_manifest_sha256",
    "oracle_bundle_ref",
    "oracle_bundle_sha256",
    "oracle_validation_report_ref",
    "oracle_validation_report_sha256",
    "oracle_bundle_hash",
    "validation_ref",
    "validation_sha256",
    "replay_ref",
    "replay_sha256",
    "replay_hash",
    "next_task_id",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage1-s1-3-formalization-index-v1"},
    "status": {"const": "PASS"},
    "gate_id": {"const": "G1-ORACLE"},
    "task_id": {"const": "stage1.03_fixtures_and_oracles"},
    "generator_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "consumer_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_branch": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "minLength": 1},
    "s1_2_index_ref": {"type": "string", "minLength": 1},
    "s1_2_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "s1_2_gate_artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_manifest_ref": {"type": "string", "minLength": 1},
    "fixture_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_bundle_ref": {"type": "string", "minLength": 1},
    "oracle_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_validation_report_ref": {"type": "string", "minLength": 1},
    "oracle_validation_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_ref": {"type": "string", "minLength": 1},
    "validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_ref": {"type": "string", "minLength": 1},
    "replay_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "next_task_id": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-asset-manifest-v1.json",
  "title": "Stage 0 immutable asset manifest",
  "description": "Canonical UTF-8 JSON without a BOM. Python validation additionally enforces canonical identity, history continuity, revision specificity, and temporary-path rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "asset_type",
    "state",
    "name",
    "source",
    "revision",
    "files",
    "state_history",
    "created_at",
    "generator_version",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0-asset-manifest-v1"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_type": {
      "enum": ["model", "tokenizer", "dataset", "source"]
    },
    "state": {
      "enum": ["downloading", "downloaded", "verified", "ready", "invalid"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable source identifier only; signed or query URLs are forbidden."
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "enum": [
          "unknown",
          "latest",
          "main",
          "master",
          "head",
          "default",
          "current",
          "none",
          "null",
          "unspecified",
          "na",
          "n/a"
        ]
      },
      "description": "Pinned immutable commit, digest, version, or snapshot identifier. Generic values are rejected case-insensitively by Python validation."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stateTransition"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_profile": {
      "const": "stage0-g3-v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator_git_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["contract_profile"]
      },
      "then": {
        "required": ["contract_profile", "candidate_id", "generator_git_commit"],
        "properties": {
          "state_history": {
            "items": {"$ref": "#/$defs/g3StateTransition"}
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["contract_profile"]},
            {"required": ["candidate_id"]},
            {"required": ["generator_git_commit"]}
          ]
        },
        "properties": {
          "state_history": {
            "items": {"$ref": "#/$defs/legacyStateTransition"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"asset_type": {"const": "model"}},
        "required": ["asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/modelMetadata"}}
      }
    },
    {
      "if": {
        "properties": {"asset_type": {"const": "tokenizer"}},
        "required": ["asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/tokenizerMetadata"}}
      }
    },
    {
      "if": {
        "properties": {"asset_type": {"const": "dataset"}},
        "required": ["asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/datasetMetadata"}}
      }
    },
    {
      "if": {
        "properties": {"asset_type": {"const": "source"}},
        "required": ["asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/sourceMetadata"}}
      }
    },
    {
      "if": {
        "properties": {
          "contract_profile": {"const": "stage0-g3-v1"},
          "asset_type": {"const": "model"}
        },
        "required": ["contract_profile", "asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/g3ModelMetadata"}}
      }
    },
    {
      "if": {
        "properties": {
          "contract_profile": {"const": "stage0-g3-v1"},
          "asset_type": {"const": "tokenizer"}
        },
        "required": ["contract_profile", "asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/g3TokenizerMetadata"}}
      }
    },
    {
      "if": {
        "properties": {
          "contract_profile": {"const": "stage0-g3-v1"},
          "asset_type": {"const": "dataset"}
        },
        "required": ["contract_profile", "asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/g3DatasetMetadata"}}
      }
    },
    {
      "if": {
        "properties": {
          "contract_profile": {"const": "stage0-g3-v1"},
          "asset_type": {"const": "source"}
        },
        "required": ["contract_profile", "asset_type"]
      },
      "then": {
        "properties": {"metadata": {"$ref": "#/$defs/g3SourceMetadata"}}
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
          "description": "Normalized relative POSIX final-object path. .part, .lock, tmp and temp components are rejected by Python validation."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "at",
        "actor",
        "actor_role",
        "evidence_ref",
        "summary"
      ],
      "properties": {
        "from": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["downloading", "downloaded", "verified", "ready", "invalid"]}
          ]
        },
        "to": {
          "enum": ["downloading", "downloaded", "verified", "ready", "invalid"]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_role": {
          "enum": ["fetcher", "verifier", "gate"]
        },
        "actor_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_ref": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 4096}
          ]
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "from": {"type": "null"},
            "to": {"const": "downloading"},
            "actor_role": {"const": "fetcher"}
          }
        },
        {
          "properties": {
            "from": {"const": "downloading"},
            "to": {"const": "downloaded"},
            "actor_role": {"const": "fetcher"}
          }
        },
        {
          "properties": {
            "from": {"const": "downloaded"},
            "to": {"const": "verified"},
            "actor_role": {"const": "verifier"}
          }
        },
        {
          "properties": {
            "from": {"const": "downloaded"},
            "to": {"const": "invalid"},
            "actor_role": {"const": "verifier"}
          }
        },
        {
          "properties": {
            "from": {"const": "verified"},
            "to": {"const": "invalid"},
            "actor_role": {"const": "verifier"}
          }
        },
        {
          "properties": {
            "from": {"const": "verified"},
            "to": {"const": "ready"},
            "actor_role": {"const": "gate"}
          }
        },
        {
          "properties": {
            "from": {"const": "ready"},
            "to": {"const": "invalid"},
            "actor_role": {"const": "gate"}
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "to": {"enum": ["verified", "ready", "invalid"]}
            },
            "required": ["to"]
          },
          "then": {
            "properties": {
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "legacyStateTransition": {
      "allOf": [
        {"$ref": "#/$defs/stateTransition"},
        {
          "not": {
            "anyOf": [
              {"required": ["actor_instance_id"]},
              {"required": ["evidence_sha256"]}
            ]
          }
        }
      ]
    },
    "g3StateTransition": {
      "allOf": [
        {"$ref": "#/$defs/stateTransition"},
        {
          "required": ["actor_instance_id", "evidence_sha256"],
          "properties": {
            "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
            "summary": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        }
      ]
    },
    "modelMetadata": {
      "type": "object",
      "required": ["architecture", "parameter_count", "dtype", "initialization_id"],
      "properties": {
        "architecture": {"type": "string", "minLength": 1, "maxLength": 256},
        "parameter_count": {"type": "integer", "minimum": 1},
        "dtype": {"type": "string", "minLength": 1, "maxLength": 128},
        "initialization_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "tokenizerMetadata": {
      "type": "object",
      "required": ["tokenizer_class", "vocab_size", "special_tokens", "normalization"],
      "properties": {
        "tokenizer_class": {"type": "string", "minLength": 1, "maxLength": 256},
        "vocab_size": {"type": "integer", "minimum": 1},
        "special_tokens": {"type": "object"},
        "normalization": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "datasetMetadata": {
      "type": "object",
      "required": ["splits", "preprocessing_version"],
      "properties": {
        "splits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/datasetSplit"}
        },
        "preprocessing_version": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "datasetSplit": {
      "type": "object",
      "required": ["sample_count", "fields"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "required": ["source_kind", "license"],
      "properties": {
        "source_kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "g3ModelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "architecture",
        "parameter_count",
        "tensor_count",
        "dtype",
        "dtype_counts",
        "max_position_embeddings",
        "config_path",
        "config_sha256",
        "initialization_id",
        "initialization_kind",
        "training_step",
        "parent_model_asset_id"
      ],
      "properties": {
        "contract_version": {"const": "stage0-model-metadata-v1"},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 256},
        "parameter_count": {"type": "integer", "minimum": 1},
        "tensor_count": {"type": "integer", "minimum": 1},
        "dtype": {"type": "string", "minLength": 1, "maxLength": 128},
        "dtype_counts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "max_position_embeddings": {"type": "integer", "minimum": 1},
        "config_path": {"$ref": "#/$defs/assetPath"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "initialization_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "initialization_kind": {"enum": ["base_initialization", "trained_checkpoint"]},
        "training_step": {"type": "integer", "minimum": 0},
        "parent_model_asset_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"initialization_kind": {"const": "base_initialization"}}},
          "then": {
            "properties": {
              "training_step": {"const": 0},
              "parent_model_asset_id": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"initialization_kind": {"const": "trained_checkpoint"}}},
          "then": {
            "properties": {
              "training_step": {"type": "integer", "minimum": 1},
              "parent_model_asset_id": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "g3TokenizerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "tokenizer_class",
        "implementation_version",
        "vocab_size",
        "token_count_with_added_tokens",
        "vocab_mapping_sha256",
        "glue_padding_policy",
        "special_tokens",
        "normalization",
        "config_path",
        "config_sha256"
      ],
      "properties": {
        "contract_version": {"const": "stage0-tokenizer-metadata-v1"},
        "tokenizer_class": {"type": "string", "minLength": 1, "maxLength": 256},
        "implementation_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "vocab_size": {"type": "integer", "minimum": 1},
        "token_count_with_added_tokens": {"type": "integer", "minimum": 1},
        "vocab_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "glue_padding_policy": {"const": "explicit_existing_added_token"},
        "special_tokens": {
          "type": "object",
          "minProperties": 1,
          "required": ["glue_padding_token"],
          "properties": {
            "glue_padding_token": {"$ref": "#/$defs/g3GluePaddingToken"}
          },
          "additionalProperties": {"$ref": "#/$defs/g3SpecialToken"}
        },
        "normalization": {"type": "string", "minLength": 1, "maxLength": 256},
        "config_path": {"$ref": "#/$defs/assetPath"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "model_max_length": {"type": "integer", "minimum": 1}
      }
    },
    "g3SpecialToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "token_id"],
      "properties": {
        "token": {"type": "string", "minLength": 1, "maxLength": 512},
        "token_id": {"type": "integer", "minimum": 0}
      }
    },
    "g3GluePaddingToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "token_id"],
      "properties": {
        "token": {"const": "<|padding|>"},
        "token_id": {"const": 1}
      }
    },
    "g3DatasetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "dataset_kind",
        "raw_revision",
        "splits",
        "preprocessing_version",
        "preprocessing",
        "storage"
      ],
      "properties": {
        "contract_version": {"const": "stage0-dataset-metadata-v1"},
        "dataset_kind": {"enum": ["raw_indexed_mmap", "derived_pretokenized", "hf_dataset", "hf_raw_parquet"]},
        "raw_revision": {"type": "string", "minLength": 1, "maxLength": 512},
        "splits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/g3DatasetSplit"}
        },
        "preprocessing_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "preprocessing": {"$ref": "#/$defs/g3Preprocessing"},
        "task_contract": {"$ref": "#/$defs/g3TaskContract"},
        "storage": {
          "oneOf": [
            {"$ref": "#/$defs/g3RawPileStorage"},
            {"$ref": "#/$defs/g3DerivedPileStorage"},
            {"$ref": "#/$defs/g3HfStorage"},
            {"$ref": "#/$defs/g3RawParquetStorage"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"dataset_kind": {"const": "raw_indexed_mmap"}}},
          "then": {
            "properties": {"storage": {"$ref": "#/$defs/g3RawPileStorage"}},
            "not": {"required": ["task_contract"]}
          }
        },
        {
          "if": {"properties": {"dataset_kind": {"const": "hf_dataset"}}},
          "then": {
            "properties": {"storage": {"$ref": "#/$defs/g3HfStorage"}},
            "not": {"required": ["task_contract"]}
          }
        },
        {
          "if": {"properties": {"dataset_kind": {"const": "hf_raw_parquet"}}},
          "then": {
            "required": ["task_contract"],
            "properties": {"storage": {"$ref": "#/$defs/g3RawParquetStorage"}}
          }
        },
        {
          "if": {"properties": {"dataset_kind": {"const": "derived_pretokenized"}}},
          "then": {
            "properties": {
              "storage": {
                "oneOf": [
                  {"$ref": "#/$defs/g3DerivedPileStorage"},
                  {"$ref": "#/$defs/g3HfStorage"}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dataset_kind": {"const": "derived_pretokenized"},
              "storage": {
                "properties": {"kind": {"const": "hf_load_from_disk"}},
                "required": ["kind"]
              }
            },
            "required": ["dataset_kind", "storage"]
          },
          "then": {"required": ["task_contract"]}
        },
        {
          "if": {
            "properties": {
              "dataset_kind": {"const": "derived_pretokenized"},
              "storage": {
                "properties": {"kind": {"const": "pile_derived_pretokenized"}},
                "required": ["kind"]
              }
            },
            "required": ["dataset_kind", "storage"]
          },
          "then": {"not": {"required": ["task_contract"]}}
        }
      ]
    },
    "g3DatasetSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "fields", "cursor"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "cursor": {"$ref": "#/$defs/halfOpenRange"}
      }
    },
    "g3Preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "config_hash",
        "code_git_commit",
        "tokenizer_asset_id",
        "parent_asset_ids"
      ],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "code_git_commit": {"$ref": "#/$defs/gitCommit"},
        "tokenizer_asset_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "parent_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "g3RawPileStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "idx",
        "tokens_per_record",
        "global_byte_coverage",
        "required_cursor_stop",
        "causal_lm_mapping",
        "reference_reader",
        "reference_batch_size",
        "reference_batch_sha256",
        "last_required_record_sha256",
        "cross_shard_policy",
        "shards"
      ],
      "properties": {
        "kind": {"const": "pythia_mmap_shards"},
        "idx": {"$ref": "#/$defs/g3PileIndex"},
        "tokens_per_record": {"const": 2049},
        "global_byte_coverage": {"$ref": "#/$defs/halfOpenRange"},
        "required_cursor_stop": {"type": "integer", "minimum": 1},
        "causal_lm_mapping": {"$ref": "#/$defs/g3CausalLmMapping"},
        "reference_reader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": {"const": "EleutherAI/pythia"},
            "revision": {"const": "a19eecb807ec2c79a39ebf18108816e6ffffc1d5"}
          }
        },
        "reference_batch_size": {"const": 1024},
        "reference_batch_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "511"],
          "properties": {
            "0": {"$ref": "#/$defs/sha256"},
            "1": {"$ref": "#/$defs/sha256"},
            "511": {"$ref": "#/$defs/sha256"}
          }
        },
        "last_required_record_sha256": {"$ref": "#/$defs/sha256"},
        "cross_shard_policy": {"const": "explicit_ordered_global_byte_stream_selected_prefix_must_be_fully_covered"},
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/g3PileShard"}
        }
      }
    },
    "g3PileIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "magic",
        "version",
        "dtype_code",
        "itemsize_bytes",
        "sequence_count",
        "document_count"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/assetPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "magic": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "integer", "minimum": 0},
        "dtype_code": {"type": "integer", "minimum": 0},
        "itemsize_bytes": {"type": "integer", "minimum": 1},
        "sequence_count": {"type": "integer", "minimum": 0},
        "document_count": {"type": "integer", "minimum": 0}
      }
    },
    "g3PileShard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "path", "size_bytes", "sha256", "byte_start", "byte_stop"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "path": {"$ref": "#/$defs/assetPath"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_stop": {"type": "integer", "minimum": 0}
      }
    },
    "g3DerivedPileStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "format",
        "causal_lm_mapping",
        "source_row_mapping",
        "converter_version",
        "converter_git_commit"
      ],
      "properties": {
        "kind": {"const": "pile_derived_pretokenized"},
        "format": {"const": "huggingface_load_from_disk"},
        "causal_lm_mapping": {"$ref": "#/$defs/g3CausalLmMapping"},
        "source_row_mapping": {"$ref": "#/$defs/g3SourceRowMapping"},
        "converter_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "converter_git_commit": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "g3CausalLmMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels_alignment",
        "source_tokens_per_record",
        "input_sequence_length",
        "label_sequence_length",
        "input_slice",
        "label_slice",
        "attention_mask_policy",
        "effective_target_tokens",
        "loss_adapter_id"
      ],
      "properties": {
        "labels_alignment": {"const": "pre_shifted_next_token"},
        "source_tokens_per_record": {"const": 2049},
        "input_sequence_length": {"const": 2048},
        "label_sequence_length": {"const": 2048},
        "input_slice": {"const": [0, 2048]},
        "label_slice": {"const": [1, 2049]},
        "attention_mask_policy": {"const": "all_one_for_fixed_full_record"},
        "effective_target_tokens": {"const": 2048},
        "loss_adapter_id": {"const": "pre-shifted-next-token-cross-entropy-v1"}
      }
    },
    "g3SourceRowMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_asset_id",
        "source_split",
        "source_cursor_start",
        "derived_row_start",
        "row_count"
      ],
      "properties": {
        "parent_asset_id": {"$ref": "#/$defs/sha256"},
        "source_split": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_cursor_start": {"type": "integer", "minimum": 0},
        "derived_row_start": {"type": "integer", "minimum": 0},
        "row_count": {"type": "integer", "minimum": 1}
      }
    },
    "g3HfStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "format_version"],
      "properties": {
        "kind": {"const": "hf_load_from_disk"},
        "format_version": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "g3RawParquetStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "splits"],
      "properties": {
        "kind": {"const": "hf_raw_parquet_files"},
        "splits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/g3RawParquetFile"}
          }
        }
      }
    },
    "g3RawParquetFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/assetPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "g3TaskContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "text_fields", "label_mapping", "unlabeled_test_policy"],
      "properties": {
        "task": {"enum": ["sst2", "mnli", "rte"]},
        "text_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "label_mapping": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "unlabeled_test_policy": {
          "const": "retain_in_raw_exclude_from_derived_training_and_evaluation"
        }
      }
    },
    "g3SourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "source_kind", "license", "upstream_locator"],
      "properties": {
        "contract_version": {"const": "stage0-source-metadata-v1"},
        "source_kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "upstream_locator": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "halfOpenRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "stop": {"type": "integer", "minimum": 0}
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}

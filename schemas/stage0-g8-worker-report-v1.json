{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g8-worker-report-v1.json",
  "title": "Stage 0 G8 Capacity Worker Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile_id", "gate_id", "model_id", "mode", "precision_profile", "candidate_stage", "repeat_index", "status", "completed_at", "generator_git_commit", "plan_ref", "plan_sha256", "config_hash", "environment_hash", "parameter_envelope_hash", "work_envelope_hash", "world_size", "selected_gpu_uuids", "nccl_p2p_disable", "rank_identities", "warmup_steps", "measured_steps", "memory_warmup_steps", "memory_measured_steps", "rank_reports", "effective_tokens_per_second", "samples_per_second", "step_median_seconds", "step_p95_seconds", "peak_memory_bytes_max", "peak_memory_fraction_max", "rank_peak_memory_imbalance_fraction", "checkpoint_pause_seconds_max", "checkpoint_bytes_total_max_boundary", "released_scratch_bytes", "open_fds_fraction_max", "synthetic_mathematics_implemented", "all_scratch_removed", "no_unknown_gpu_processes", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "stage0-g8-worker-report-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "profile_id": {"enum": ["g8-c-14m", "g8-s4-160m", "g8-s5-410m"]},
    "gate_id": {"enum": ["stage0.G8-C", "stage0.G8-S4", "stage0.G8-S5"]},
    "model_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["minimal", "formal"]},
    "precision_profile": {"enum": ["fp32", "bf16"]},
    "candidate_stage": {"enum": [0, 4, 5]},
    "repeat_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "status": {"const": "PASS"},
    "completed_at": {"type": "string", "format": "date-time"},
    "generator_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_ref": {"$ref": "#/$defs/ref"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "environment_hash": {"$ref": "#/$defs/hash"},
    "parameter_envelope_hash": {"$ref": "#/$defs/hash"},
    "work_envelope_hash": {"$ref": "#/$defs/hash"},
    "world_size": {"enum": [1, 4]},
    "selected_gpu_uuids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^GPU-"}},
    "nccl_p2p_disable": {"const": 1},
    "rank_identities": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "warmup_steps": {"const": 10},
    "measured_steps": {"const": 30},
    "memory_warmup_steps": {"const": 5},
    "memory_measured_steps": {"const": 20},
    "rank_reports": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "effective_tokens_per_second": {"type": "number", "exclusiveMinimum": 0},
    "samples_per_second": {"type": "number", "exclusiveMinimum": 0},
    "step_median_seconds": {"type": "number", "minimum": 0},
    "step_p95_seconds": {"type": "number", "minimum": 0},
    "peak_memory_bytes_max": {"type": "integer", "minimum": 1},
    "peak_memory_fraction_max": {"type": "number", "minimum": 0, "maximum": 0.8},
    "rank_peak_memory_imbalance_fraction": {"type": "number", "minimum": 0},
    "checkpoint_pause_seconds_max": {"type": "number", "minimum": 0},
    "checkpoint_bytes_total_max_boundary": {"type": "integer", "minimum": 1},
    "released_scratch_bytes": {"type": "integer", "minimum": 1},
    "open_fds_fraction_max": {"type": "number", "minimum": 0, "maximum": 0.7},
    "synthetic_mathematics_implemented": {"const": false},
    "all_scratch_removed": {"const": true},
    "no_unknown_gpu_processes": {"const": true},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parameter-importance.invalid/schemas/stage0-g5-worker-report-v1.json",
  "title": "Stage 0 G5 fresh-process worker report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "run_kind", "repeat_index", "status", "pid",
    "parent_pid", "started_at", "completed_at", "generator_git_commit",
    "plan_ref", "plan_sha256", "config_ref", "config_sha256", "config_hash",
    "config_full_hash", "environment_ref", "environment_sha256",
    "environment_hash", "device", "phase_memory", "training_wall_seconds",
    "training_result", "event_stream_ref", "event_stream_semantic_sha256",
    "checkpoint_commits", "asset_evidence", "resource_profiles",
    "selected_tensor_bundle_ref", "selected_tensor_bundle_sha256",
    "selected_tensor_names", "data_boundary", "step_telemetry", "failure",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "stage0-g5-worker-report-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_kind": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 0},
    "status": {"enum": ["PASS", "EXPECTED_FAILURE_CONFIRMED"]},
    "pid": {"type": "integer", "minimum": 1},
    "parent_pid": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "generator_git_commit": {"$ref": "#/$defs/git_commit"},
    "plan_ref": {"$ref": "#/$defs/logical_ref"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "config_ref": {"$ref": "#/$defs/logical_ref"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "config_hash": {"$ref": "#/$defs/sha256"},
    "config_full_hash": {"$ref": "#/$defs/sha256"},
    "environment_ref": {"$ref": "#/$defs/logical_ref"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "environment_hash": {"$ref": "#/$defs/sha256"},
    "device": {"type": "object"},
    "phase_memory": {"type": "array", "items": {"type": "object"}},
    "training_wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "training_result": {"type": ["object", "null"]},
    "event_stream_ref": {"anyOf": [{"$ref": "#/$defs/logical_ref"}, {"type": "null"}]},
    "event_stream_semantic_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "checkpoint_commits": {"type": "array", "items": {"type": "object"}},
    "asset_evidence": {"type": "array", "items": {"type": "object"}},
    "resource_profiles": {"type": "array", "items": {"type": "object"}},
    "selected_tensor_bundle_ref": {"anyOf": [{"$ref": "#/$defs/logical_ref"}, {"type": "null"}]},
    "selected_tensor_bundle_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "selected_tensor_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "data_boundary": {"type": ["object", "null"]},
    "step_telemetry": {"type": "array", "items": {"type": "object"}},
    "failure": {"type": ["object", "null"]},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_ref": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^:]+$"
    }
  }
}
